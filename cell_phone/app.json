{
  "expo": {
    "name": "Agro",
    "slug": "agro-cell-phone",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#244b3b"
    },
    "scheme": "agro",
    "primaryColor": "#244b3b",
    "icon": "./assets/adaptive-icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.agro.cellphone"
    },
    "android": {
      "package": "com.agro.cellphone",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#244b3b"
      }
    },
    "plugins": [
      [
        "expo-sqlite",
        {
          "enableFTS": false
        }
      ],
      "expo-asset",
      "expo-sharing",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/adaptive-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#244b3b"
        }
      ]
    ]
  }
}
